---
const nav = [
  { label: '系列', href: '/series/' },
  { label: '事件', href: '/events/' },
  { label: '關於', href: '/about/' },
];
---

<aside class="sidebar">
  <a href="/" class="artist-name">
    <img class="name-img" src="/xiao.png" alt="xiao" />
    <span class="name-cn">蕭愚</span>
  </a>
  <nav>
    {nav.map(item => (
      <a
        href={item.href}
        class:list={["nav-link", { active: Astro.url.pathname.startsWith(item.href) }]}
      >
        {item.label}
      </a>
    ))}
  </nav>
  {Astro.url.pathname === '/' && (
    <button class="reload-btn" onclick="document.querySelectorAll('.gallery-wrapper').forEach(function(el){el.dispatchEvent(new Event('reshuffle'))})" title="重新排列">
      <img src="/reload.png" alt="↻" width="20" height="9" />
    </button>
  )}
</aside>

<style>
  .sidebar {
    width: var(--sidebar-width);
    padding: var(--content-padding) 24px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .artist-name {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    margin-bottom: 28px;
    line-height: 1.3;
  }
  .name-img {
    display: block;
    width: auto;
    height: auto;
  }
  .name-cn {
    font-size: 40px;
    color: #111;
    letter-spacing: 0;
    font-style: normal;
  }
  .artist-name:hover { opacity: 0.7; }
  .nav-link {
    font-size: 20px;
    color: var(--text-muted);
    padding: 3px 0;
    display: block;
    transition: color 0.2s;
  }
  .nav-link:hover, .nav-link.active {
    color: #111;
  }
  .reload-btn {
    margin-top: 20px;
    background: none; border: none; cursor: pointer;
    padding: 4px 0; opacity: 0.5; transition: opacity 0.2s;
  }
  .reload-btn:hover { opacity: 1; }
  .reload-btn img { display: block; }
  @media (max-width: 600px) {
    .sidebar {
      width: 100%;
      flex-direction: row;
      align-items: baseline;
      gap: 16px;
      padding: 16px 20px;
      flex-wrap: wrap;
    }
    .artist-name {
      margin-bottom: 0;
      margin-right: auto;
      flex-direction: row;
      gap: 6px;
    }
    nav {
      display: flex;
      gap: 16px;
    }
    .name-img { display: none; }
  }
</style>
