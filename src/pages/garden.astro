---
import '../styles/global.css';
import '../styles/garden.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>海中花园</title>
  </head>
  <body class="garden-body">
    <div class="garden-page">
      <aside class="garden-sidebar">
        <div class="garden-sidebar-inner">
          <a class="garden-title" href="/garden/">海中花园</a>
          <nav class="garden-nav" id="garden-nav" aria-label="花园导航" hidden></nav>
        </div>
      </aside>
      <main class="garden-content" id="garden-root"></main>
    </div>

    <script>
      import { init } from '../components/garden/app';
      init();
    </script>
  </body>
</html>
